# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*

# Signing and store credentials. Nothing here is ever tracked: the release
# keystore and the Apple certs live on EAS's servers, and a local
# credentials.json only ever exists on this machine. See docs/release.md.
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
credentials.json
google-services.json
GoogleService-Info.plist
.expo-shared/

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
*.log
eas-build-*.log

# macOS
.DS_Store
*.pem

# local env files — everything but the committed template
.env*
!.env.example

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
modules/**/android/build/
modules/**/android/.cxx/

.playwright-mcp/
tabbar-check.png

# local screenshots / scratch
var/
modules/*/android/build/

# session screenshots dropped in the root
/*.png

# working notes — session logs, plans, specs, store paperwork.
# They stay on disk; the public repo shows the product, not the notebook.
docs/internal/

# local planning scratch, not part of the app
plans/
redesign/
